# Production coach<->rower link: the relay Worker in relay/, deployed with
# `npm run relay:deploy`. Paste the URL wrangler prints here (https://… is
# fine; the app switches it to wss:// for the WebSocket). Leave it empty and
# the app falls back to WebRTC via PeerJS, which rarely connects across two
# cell carriers.
VITE_RELAY_URL=https://free-speed-relay.free-speed-rowing.workers.dev
